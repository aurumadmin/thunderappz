# =============================================================================
# Thunder Appz Configuration Environment Variables
# =============================================================================

# PORT: Server network port.
# - On VPS / cPanel standalone: Set to any desired port (defaults to 3001 so it does not conflict with port 3000).
# - On cPanel Passenger: Handled automatically by CloudLinux Passenger socket.
PORT=3001

# NODE_ENV: Set to 'production' on live servers (cPanel sets this via Application Mode)
NODE_ENV=production

# APP_URL: The public canonical URL of your website (e.g., https://thunder-appz.eu.org)
# Used for sitemaps, AdsLab callbacks, and self-referential links.
APP_URL=https://thunder-appz.eu.org

# GEMINI_API_KEY: Optional Gemini AI API key for dynamic content generation
GEMINI_API_KEY=""
